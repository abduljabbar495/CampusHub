# Copy to .env (or set as Render environment variables)
DEBUG=1
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
# Separate key used to encrypt MFA secrets and visitor ID numbers (falls back to SECRET_KEY)
FIELD_ENCRYPTION_KEY=
# Database: leave DB_ENGINE unset for SQLite (quick start) or use mysql
DB_ENGINE=mysql
DB_NAME=campushub
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
# Optional: auto-create an admin on deploy
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
